# Ethereum RPC (Alchemy / Infura / QuickNode / own node). Public fallbacks are used if empty.
VITE_MAINNET_RPC=
VITE_SEPOLIA_RPC=
# Transaction history provider: set one of these.
VITE_ETHERSCAN_KEY=
VITE_ALCHEMY_KEY=
# WalletConnect Cloud project id (optional). Used only to sign the audit-anchor transaction, never to sign in.
VITE_WC_PROJECT_ID=
# AuditAnchor contract address on Sepolia (from chainintel-contracts deploy).
VITE_ANCHOR_ADDRESS=

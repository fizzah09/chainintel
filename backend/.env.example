# Copy this to .env and fill in values (never commit .env)

# PostgreSQL — Neon.tech free tier connection string
CI_DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.us-east-1.aws.neon.tech/chainintel?sslmode=require

# Etherscan API key (free at etherscan.io/register)
CI_ETHERSCAN_API_KEY=your_key_here

# Redis — optional, app works without it (Upstash free tier if you want it)
# CI_REDIS_URL=redis://default:password@xxx.upstash.io:6379

# CORS — accepts a JSON array or comma-separated origins
# CI_CORS_ORIGINS=["https://chainintel.pages.dev"]

# Environment
CI_ENV=production

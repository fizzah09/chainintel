# Copy to backend/.env for local development. Never commit backend/.env.
# In a bank deployment these come from the vault / secret manager, not a file.

CI_ENV=development
CI_DATABASE_URL=postgresql+psycopg://chainintel:chainintel@127.0.0.1:5432/chainintel
CI_REDIS_URL=redis://127.0.0.1:6379/0
CI_CORS_ORIGINS=["http://localhost:5173"]

# M3 blockchain data. Leave empty to run without live data (tests never need keys).
CI_ETHERSCAN_API_KEY=
CI_ETHERSCAN_COMMERCIAL_PLAN=false
CI_ALCHEMY_API_KEY=
